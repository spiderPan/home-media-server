# Plex Claim Token (Get one at https://www.plex.tv/claim/)
PLEX_CLAIM=claim-xxxxxxxxxxxxxx

# User and Group IDs (Run `id` in your terminal to find these)
PUID=1000
PGID=1000

# Timezone
TZ=UTC

# External Disk Path
# Set this to the absolute path of your media storage disk
# Example: /media/user/MyPassport
MEDIA_DISK="/path/to/your/external/disk"

# Homepage Credentials
HOMEPAGE_RADARR_KEY=your_radarr_api_key
HOMEPAGE_SONARR_KEY=your_sonarr_api_key
HOMEPAGE_PROWLARR_KEY=your_prowlarr_api_key
HOMEPAGE_BAZARR_KEY=your_bazarr_api_key
HOMEPAGE_QBIT_USER=admin
HOMEPAGE_QBIT_PASS=adminadmin
HOMEPAGE_ALLOWED_HOSTS=media.local,localhost
